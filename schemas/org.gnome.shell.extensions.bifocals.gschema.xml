<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="bifocals@shiznatix">

  <schema id="org.gnome.shell.extensions.bifocals" path="/org/gnome/shell/extensions/bifocals/">

    <key type="as" name="cycle-midscreen">
      <default><![CDATA[['<Super><Ctrl>c']]]></default>
      <summary>Cycle midscreen sizes</summary>
    </key>

    <key type="as" name="cycle-left">
      <default><![CDATA[['<Super><Ctrl>Left']]]></default>
      <summary>Cycle left anchoring</summary>
    </key>

    <key type="as" name="cycle-right">
      <default><![CDATA[['<Super><Ctrl>Right']]]></default>
      <summary>Cycle right anchoring</summary>
    </key>

    <key type="as" name="cycle-top">
      <default><![CDATA[['<Super><Ctrl>Up']]]></default>
      <summary>Cycle top anchoring</summary>
    </key>

    <key type="as" name="cycle-bottom">
      <default><![CDATA[['<Super><Ctrl>Down']]]></default>
      <summary>Cycle bottom anchoring</summary>
    </key>

    <key type="as" name="move-monitor-left">
      <default><![CDATA[['<Super><Ctrl>Home']]]></default>
      <summary>Move one monitor left</summary>
    </key>

    <key type="as" name="move-monitor-right">
      <default><![CDATA[['<Super><Ctrl>End']]]></default>
      <summary>Move one monitor right</summary>
    </key>

    <key type="as" name="move-monitor-up">
      <default><![CDATA[['<Super><Ctrl>Page_Up']]]></default>
      <summary>Move one monitor up</summary>
    </key>

    <key type="as" name="move-monitor-down">
      <default><![CDATA[['<Super><Ctrl>Page_Down']]]></default>
      <summary>Move one monitor down</summary>
    </key>

    <key type="as" name="toggle-maximize">
      <default><![CDATA[['<Super><Ctrl>Return']]]></default>
      <summary>Toggle maximize</summary>
    </key>

    <key type="as" name="restore-window">
      <default><![CDATA[['<Super><Ctrl>BackSpace']]]></default>
      <summary>Restore to pre-Bifocals geometry</summary>
    </key>

    <key type="i" name="resize-left-right-small">
      <default>33</default>
      <summary>Left / right small size</summary>
    </key>
    <key type="b" name="resize-left-right-small-enabled">
      <default>true</default>
      <summary>Left / right small size enabled</summary>
    </key>
    <key type="i" name="resize-left-right-medium">
      <default>50</default>
      <summary>Left / right medium size</summary>
    </key>
    <key type="b" name="resize-left-right-medium-enabled">
      <default>true</default>
      <summary>Left / right medium size enabled</summary>
    </key>
    <key type="i" name="resize-left-right-large">
      <default>67</default>
      <summary>Left / right large size</summary>
    </key>
    <key type="b" name="resize-left-right-large-enabled">
      <default>true</default>
      <summary>Left / right large size enabled</summary>
    </key>

    <key type="i" name="resize-top-bottom-small">
      <default>33</default>
      <summary>Top / bottom small size</summary>
    </key>
    <key type="b" name="resize-top-bottom-small-enabled">
      <default>true</default>
      <summary>Top / bottom small size enabled</summary>
    </key>
    <key type="i" name="resize-top-bottom-medium">
      <default>50</default>
      <summary>Top / bottom medium size</summary>
    </key>
    <key type="b" name="resize-top-bottom-medium-enabled">
      <default>true</default>
      <summary>Top / bottom medium size enabled</summary>
    </key>
    <key type="i" name="resize-top-bottom-large">
      <default>67</default>
      <summary>Top / bottom large size</summary>
    </key>
    <key type="b" name="resize-top-bottom-large-enabled">
      <default>true</default>
      <summary>Top / bottom large size enabled</summary>
    </key>

    <key type="i" name="resize-midscreen-small">
      <default>20</default>
      <summary>Midscreen small size</summary>
    </key>
    <key type="b" name="resize-midscreen-small-enabled">
      <default>true</default>
      <summary>Midscreen small size enabled</summary>
    </key>
    <key type="i" name="resize-midscreen-medium">
      <default>25</default>
      <summary>Midscreen medium size</summary>
    </key>
    <key type="b" name="resize-midscreen-medium-enabled">
      <default>true</default>
      <summary>Midscreen medium size enabled</summary>
    </key>
    <key type="i" name="resize-midscreen-large">
      <default>33</default>
      <summary>Midscreen large size</summary>
    </key>
    <key type="b" name="resize-midscreen-large-enabled">
      <default>true</default>
      <summary>Midscreen large size enabled</summary>
    </key>

    <!--
      Renamed to cycle-* in 5.0. Kept only so a user's old shortcut can be read
      and cleared once, on the next enable. A key cannot be read or reset unless
      the schema still declares it. No summary, so they stay out of translation.
      Safe to drop once upgrades from 4.x are no longer a concern.
    -->
    <key type="as" name="midscreen">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="toggle-left">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="toggle-right">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="toggle-top">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="toggle-bottom">
      <default><![CDATA[[]]]></default>
    </key>

  </schema>

</schemalist>
