#. Preferences window title
msgid "Bifocal Preferences"
msgstr "Preferencias de Bifocals"

#. Keybindings group title
msgid "Keybindings"
msgstr "Atajos de teclado"

#. Keybindings group description
msgid "Configure the extension keybindings"
msgstr "Configurar los atajos de teclado de la extensión"

#. Left/right resize group title
msgid "Left / Right Sizes"
msgstr "Tamaños izquierda / derecha"

#. Left/right resize group description
msgid "% of screen width"
msgstr "% del ancho de pantalla"

#. Top/bottom resize group title
msgid "Top / Bottom Sizes"
msgstr "Tamaños superior / inferior"

#. Top/bottom resize group description
msgid "% of screen height"
msgstr "% de la altura de pantalla"

#. Midscreen resize group title
msgid "Midscreen Sizes"
msgstr "Tamaños centro de pantalla"

#. Midscreen resize group description
msgid "% of screen"
msgstr "% de la pantalla"

#. Resize size labels
msgid "Small"
msgstr "Pequeño"

msgid "Medium"
msgstr "Mediano"

msgid "Large"
msgstr "Grande"

#. Tooltip for per-row reset button in resize groups
msgid "Restore default"
msgstr "Restaurar predeterminado"

#. Subtitle shown on a resize row when it will never be triggered due to ordering
msgid "Value must be larger than previous size"
msgstr "El valor debe ser mayor que el tamaño anterior"

#. Restore all defaults row title
msgid "Restore All Defaults"
msgstr "Restaurar todos los valores predeterminados"

#. Restore all defaults row subtitle
msgid "Reset all preferences to their default values"
msgstr "Restablecer todas las preferencias a sus valores predeterminados"

#. Restore all defaults button label
msgid "Restore All"
msgstr "Restaurar todo"

#. Confirmation dialog heading for restore all
msgid "Restore All Defaults?"
msgstr "¿Restaurar todos los valores predeterminados?"

#. Confirmation dialog body for restore all
msgid "All preferences will be reset to their default values. This cannot be undone."
msgstr "Todas las preferencias se restablecerán a sus valores predeterminados. Esto no se puede deshacer."

#. Generic cancel button label
msgid "Cancel"
msgstr "Cancelar"

#. Tooltip for the reset button on each shortcut row
msgid "Reset the shortcut to its default value"
msgstr "Restablecer el atajo a su valor predeterminado"

#. Displayed when no shortcut is set
msgid "<Unset>"
msgstr "<Sin asignar>"

#. Shortcut rebind dialog heading
msgid "Set shortcut"
msgstr "Establecer atajo"

#. Shortcut rebind dialog body shown while awaiting key input
msgid "awaiting input…"
msgstr "esperando entrada…"

#. Shortcut rebind dialog button: add a new shortcut alongside existing ones
msgid "Add shortcut"
msgstr "Añadir atajo"

#. Shortcut rebind dialog button: replace all existing shortcuts
msgid "Replace shortcut(s)"
msgstr "Reemplazar atajo(s)"

#. Shortcut rebind dialog help text
msgid "Note: This dialog only detects shortcuts that are not actively intercepted by Gnome shell, e.g., natively or through another extension."
msgstr "Nota: este diálogo solo detecta atajos que no son interceptados activamente por el shell de Gnome, p. ej., de forma nativa o a través de otra extensión."

msgid "Press <b>ESC</b> to close the dialog."
msgstr "Pulse <b>ESC</b> para cerrar el diálogo."

msgid "Press <b>BackSpace</b> to unset the keybinding."
msgstr "Pulse <b>BackSpace</b> para eliminar el atajo de teclado."

#. GSettings schema summaries
msgid "Midscreen"
msgstr "Centro de pantalla"

msgid "Toggle left anchoring"
msgstr "Alternar anclaje a la izquierda"

msgid "Toggle right anchoring"
msgstr "Alternar anclaje a la derecha"

msgid "Toggle top anchoring"
msgstr "Alternar anclaje arriba"

msgid "Toggle bottom anchoring"
msgstr "Alternar anclaje abajo"

msgid "Move one monitor left"
msgstr "Mover un monitor a la izquierda"

msgid "Move one monitor right"
msgstr "Mover un monitor a la derecha"

msgid "Move one monitor up"
msgstr "Mover un monitor arriba"

msgid "Move one monitor down"
msgstr "Mover un monitor abajo"

msgid "Toggle maximize"
msgstr "Alternar maximizar"

msgid "Restore to pre-Bifocals geometry"
msgstr "Restaurar a la geometría previa a Bifocals"

msgid "Left / right small size"
msgstr "Tamaño pequeño izquierda / derecha"

msgid "Left / right small size enabled"
msgstr "Tamaño pequeño izquierda / derecha activado"

msgid "Left / right medium size"
msgstr "Tamaño mediano izquierda / derecha"

msgid "Left / right medium size enabled"
msgstr "Tamaño mediano izquierda / derecha activado"

msgid "Left / right large size"
msgstr "Tamaño grande izquierda / derecha"

msgid "Left / right large size enabled"
msgstr "Tamaño grande izquierda / derecha activado"

msgid "Top / bottom small size"
msgstr "Tamaño pequeño superior / inferior"

msgid "Top / bottom small size enabled"
msgstr "Tamaño pequeño superior / inferior activado"

msgid "Top / bottom medium size"
msgstr "Tamaño mediano superior / inferior"

msgid "Top / bottom medium size enabled"
msgstr "Tamaño mediano superior / inferior activado"

msgid "Top / bottom large size"
msgstr "Tamaño grande superior / inferior"

msgid "Top / bottom large size enabled"
msgstr "Tamaño grande superior / inferior activado"

msgid "Midscreen small size"
msgstr "Tamaño pequeño centro de pantalla"

msgid "Midscreen small size enabled"
msgstr "Tamaño pequeño centro de pantalla activado"

msgid "Midscreen medium size"
msgstr "Tamaño mediano centro de pantalla"

msgid "Midscreen medium size enabled"
msgstr "Tamaño mediano centro de pantalla activado"

msgid "Midscreen large size"
msgstr "Tamaño grande centro de pantalla"

msgid "Midscreen large size enabled"
msgstr "Tamaño grande centro de pantalla activado"
