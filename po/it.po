#. Preferences window title
msgid "Bifocals Preferences"
msgstr "Preferenze di Bifocals"

#. Keybindings group title
msgid "Keybindings"
msgstr "Scorciatoie da tastiera"

#. Keybindings group description
msgid "Configure the extension keybindings"
msgstr "Configura le scorciatoie da tastiera dell'estensione"

#. Left/right resize group title
msgid "Left / Right Sizes"
msgstr "Dimensioni sinistra / destra"

#. Left/right resize group description
msgid "% of screen width"
msgstr "% larghezza schermo"

#. Top/bottom resize group title
msgid "Top / Bottom Sizes"
msgstr "Dimensioni alto / basso"

#. Top/bottom resize group description
msgid "% of screen height"
msgstr "% altezza schermo"

#. Midscreen resize group title
msgid "Midscreen Sizes"
msgstr "Dimensioni centro schermo"

#. Midscreen resize group description
msgid "% of screen"
msgstr "% dello schermo"

#. Increase / decrease group title
msgid "Increase / Decrease Size"
msgstr "Aumenta / riduci dimensione"

#. Increase / decrease group description
msgid "% of screen per step"
msgstr "% dello schermo per passo"

#. Resize size labels
msgid "Small"
msgstr "Piccolo"

msgid "Medium"
msgstr "Medio"

msgid "Large"
msgstr "Grande"

#. Increase / decrease step row label
msgid "Step"
msgstr "Passo"

#. Tooltip for per-row reset button in resize groups
msgid "Restore default"
msgstr "Ripristina predefinito"

#. Subtitle shown on a resize row when it will never be triggered due to ordering
msgid "Value must be larger than previous size"
msgstr "Il valore deve essere maggiore della dimensione precedente"

#. Restore all defaults row title
msgid "Restore All Defaults"
msgstr "Ripristina tutti i valori predefiniti"

#. Restore all defaults row subtitle
msgid "Reset all preferences to their default values"
msgstr "Reimposta tutte le preferenze ai valori predefiniti"

#. Restore all defaults button label
msgid "Restore All"
msgstr "Ripristina tutto"

#. Confirmation dialog heading for restore all
msgid "Restore All Defaults?"
msgstr "Ripristinare tutti i valori predefiniti?"

#. Confirmation dialog body for restore all
msgid "All preferences will be reset to their default values. This cannot be undone."
msgstr "Tutte le preferenze verranno reimpostate ai valori predefiniti. Questa operazione non può essere annullata."

#. Generic cancel button label
msgid "Cancel"
msgstr "Annulla"

#. Tooltip for the reset button on each shortcut row
msgid "Reset the shortcut to its default value"
msgstr "Reimposta la scorciatoia al valore predefinito"

#. Displayed when no shortcut is set
msgid "<Unset>"
msgstr "<Non impostato>"

#. Shortcut rebind dialog heading
msgid "Set shortcut"
msgstr "Imposta scorciatoia"

#. Shortcut rebind dialog body shown while awaiting key input
msgid "awaiting input…"
msgstr "in attesa di input…"

#. Shortcut rebind dialog button: add a new shortcut alongside existing ones
msgid "Add shortcut"
msgstr "Aggiungi scorciatoia"

#. Shortcut rebind dialog button: replace all existing shortcuts
msgid "Replace shortcut(s)"
msgstr "Sostituisci scorciatoia(e)"

#. Shortcut rebind dialog help text
msgid "Note: This dialog only detects shortcuts that are not actively intercepted by Gnome shell, e.g., natively or through another extension."
msgstr "Nota: questa finestra di dialogo rileva solo le scorciatoie che non sono attivamente intercettate dalla shell di Gnome, ad es. in modo nativo o tramite un'altra estensione."

msgid "Press <b>ESC</b> to close the dialog."
msgstr "Premere <b>ESC</b> per chiudere la finestra di dialogo."

msgid "Press <b>BackSpace</b> to unset the keybinding."
msgstr "Premere <b>BackSpace</b> per rimuovere la scorciatoia da tastiera."

#. GSettings schema summaries
msgid "Cycle midscreen sizes"
msgstr "Scorri dimensioni centro schermo"

msgid "Cycle left anchoring"
msgstr "Scorri ancoraggio a sinistra"

msgid "Cycle right anchoring"
msgstr "Scorri ancoraggio a destra"

msgid "Cycle top anchoring"
msgstr "Scorri ancoraggio in alto"

msgid "Cycle bottom anchoring"
msgstr "Scorri ancoraggio in basso"

msgid "Increase window size"
msgstr "Aumenta la dimensione della finestra"

msgid "Decrease window size"
msgstr "Riduci la dimensione della finestra"

msgid "Move one monitor left"
msgstr "Sposta di un monitor a sinistra"

msgid "Move one monitor right"
msgstr "Sposta di un monitor a destra"

msgid "Move one monitor up"
msgstr "Sposta di un monitor in alto"

msgid "Move one monitor down"
msgstr "Sposta di un monitor in basso"

msgid "Toggle maximize"
msgstr "Attiva/disattiva massimizza"

msgid "Restore to pre-Bifocals geometry"
msgstr "Ripristina la geometria precedente a Bifocals"

msgid "Left / right small size"
msgstr "Dimensione piccola sinistra / destra"

msgid "Left / right small size enabled"
msgstr "Dimensione piccola sinistra / destra attivata"

msgid "Left / right medium size"
msgstr "Dimensione media sinistra / destra"

msgid "Left / right medium size enabled"
msgstr "Dimensione media sinistra / destra attivata"

msgid "Left / right large size"
msgstr "Dimensione grande sinistra / destra"

msgid "Left / right large size enabled"
msgstr "Dimensione grande sinistra / destra attivata"

msgid "Top / bottom small size"
msgstr "Dimensione piccola alto / basso"

msgid "Top / bottom small size enabled"
msgstr "Dimensione piccola alto / basso attivata"

msgid "Top / bottom medium size"
msgstr "Dimensione media alto / basso"

msgid "Top / bottom medium size enabled"
msgstr "Dimensione media alto / basso attivata"

msgid "Top / bottom large size"
msgstr "Dimensione grande alto / basso"

msgid "Top / bottom large size enabled"
msgstr "Dimensione grande alto / basso attivata"

msgid "Midscreen small size"
msgstr "Dimensione piccola centro schermo"

msgid "Midscreen small size enabled"
msgstr "Dimensione piccola centro schermo attivata"

msgid "Midscreen medium size"
msgstr "Dimensione media centro schermo"

msgid "Midscreen medium size enabled"
msgstr "Dimensione media centro schermo attivata"

msgid "Midscreen large size"
msgstr "Dimensione grande centro schermo"

msgid "Midscreen large size enabled"
msgstr "Dimensione grande centro schermo attivata"

msgid "Increase / decrease step"
msgstr "Passo di aumento / riduzione"
